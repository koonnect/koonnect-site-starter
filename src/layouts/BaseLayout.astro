---
import "../styles/global.css";
import Header from "../components/marketing/layout/Header.astro";
import Footer from "../components/marketing/layout/Footer.astro";
import { buildCanonical } from "../lib/seo/metadata";
import { buildBaseStructuredData, type JsonLd } from "../lib/seo/jsonld";
import { getSettings } from "../lib/content/settings";
import type { Locale } from "../lib/routing/locales";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  structuredData?: JsonLd | JsonLd[];
};

const { locale, title, description, structuredData } = Astro.props;
const settings = await getSettings(locale);
const pathname = Astro.url.pathname.replace(`/${locale}`, "") || "/";
const canonical = buildCanonical(locale, pathname);
const extraStructuredData = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const structuredDataItems = [
  ...buildBaseStructuredData({ locale, title, description, pathname }),
  ...extraStructuredData,
];
---

<!doctype html>
<html lang={locale} class="koon">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {structuredDataItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class="site-shell">
    <Header locale={locale} menus={settings.menus} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} menus={settings.menus} certifications={settings.certifications} />
  </body>
</html>
