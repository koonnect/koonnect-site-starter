---
type Props = {
  entry: {
    data: {
      title: string;
      excerpt: string;
      category: string;
      publishedAt: Date;
      heroImage: string;
      slug: string;
      locale: string;
    };
  };
};

const { entry } = Astro.props;
---

<article class="surface-card overflow-hidden">
  <img src={entry.data.heroImage} alt={entry.data.title} class="h-48 w-full object-cover" />
  <div class="space-y-4 p-6">
    <div class="text-xs uppercase tracking-[0.24em] text-[var(--koon-gold)]">{entry.data.category}</div>
    <h3 class="text-2xl font-semibold text-white">{entry.data.title}</h3>
    <p class="text-sm leading-7 text-white/65">{entry.data.excerpt}</p>
    <a href={`/${entry.data.locale}/blog/${entry.data.slug}`} class="text-sm font-semibold text-[var(--koon-blue)] no-underline">
      Ler artigo
    </a>
  </div>
</article>
