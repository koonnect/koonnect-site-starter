---
import type { Locale } from "../../../lib/routing/locales";

type Props = {
  locale: Locale;
  menus?: {
    nav?: {
      solutionsLabel: string;
      platformLabel: string;
      directLinks: { label: string; href: string; enabled: boolean }[];
      demoCta: { label: string; href: string };
    };
  };
};

const { locale, menus } = Astro.props;
const nav = menus?.nav;
---

<header class="sticky top-0 z-20 border-b border-white/10 bg-black/45 backdrop-blur-xl">
  <div class="container-shell flex items-center justify-between gap-6 py-4">
    <a href={`/${locale}`} class="flex items-center gap-3 text-white no-underline">
      <img src="/logo-mark.png" alt="Koonnect starter" class="h-10 w-10 rounded-full object-cover" />
      <span class="text-sm font-semibold tracking-[0.18em] uppercase text-white/80">Koonnect</span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      <span class="text-sm text-white/75">{nav?.solutionsLabel ?? "Solutions"}</span>
      <span class="text-sm text-white/75">{nav?.platformLabel ?? "Platform"}</span>
      {nav?.directLinks.filter((item) => item.enabled).map((item) => (
        <a href={`/${locale}${item.href}`} class="text-sm text-white/75 no-underline transition hover:text-white">
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href={`/${locale}${nav?.demoCta.href ?? "/contact"}`}
      class="rounded-full bg-[var(--koon-blue)] px-5 py-3 text-sm font-semibold text-white no-underline shadow-[0_0_20px_rgba(0,147,252,0.35)] transition hover:brightness-110"
    >
      {nav?.demoCta.label ?? "Request demo"}
    </a>
  </div>
</header>
