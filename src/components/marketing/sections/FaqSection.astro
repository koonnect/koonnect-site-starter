---
import SectionShell from "../layout/SectionShell.astro";

type Props = {
  data: {
    eyebrow: string;
    title: string[];
    items: { question: string; answer: string }[];
  };
};

const { data } = Astro.props;
---

<SectionShell eyebrow={data.eyebrow} title={data.title}>
  <div class="grid gap-4">
    {data.items.map((item) => (
      <article class="surface-card p-6">
        <h3 class="text-xl font-semibold text-white">{item.question}</h3>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-white/65">{item.answer}</p>
      </article>
    ))}
  </div>
</SectionShell>
