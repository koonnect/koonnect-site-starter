---
import SectionShell from "../layout/SectionShell.astro";

type Props = {
  data: {
    eyebrow: string;
    title: string[];
    blocks: { title: string; text: string }[];
  };
};

const { data } = Astro.props;
---

<SectionShell eyebrow={data.eyebrow} title={data.title}>
  <div class="mx-auto grid max-w-4xl gap-6">
    {data.blocks.map((block) => (
      <article class="surface-card p-7">
        <h3 class="text-2xl font-semibold text-white">{block.title}</h3>
        <p class="mt-4 text-sm leading-8 text-white/70">{block.text}</p>
      </article>
    ))}
  </div>
</SectionShell>
