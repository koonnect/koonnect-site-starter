---
import SectionHeading from "../primitives/SectionHeading.astro";

type Props = {
  data: {
    eyebrow: string;
    title: string[];
    description: string;
    primaryCta: { label: string; href: string };
    secondaryCta?: { label: string; href: string };
    media?: { src: string; alt: string };
  };
};

const { data } = Astro.props;
---

<section class="container-shell grid gap-10 py-16 md:grid-cols-[1.1fr_0.9fr] md:py-24">
  <div class="space-y-8">
    <SectionHeading eyebrow={data.eyebrow} title={data.title} description={data.description} />
    <div class="flex flex-wrap gap-4">
      <a href={data.primaryCta.href} class="rounded-full bg-[var(--koon-blue)] px-6 py-3 text-sm font-semibold text-white no-underline shadow-[0_0_20px_rgba(0,147,252,0.35)]">
        {data.primaryCta.label}
      </a>
      {data.secondaryCta && (
        <a href={data.secondaryCta.href} class="rounded-full border border-white/15 px-6 py-3 text-sm font-semibold text-white/80 no-underline hover:text-white">
          {data.secondaryCta.label}
        </a>
      )}
    </div>
  </div>

  <div class="surface-card overflow-hidden p-4">
    {data.media ? (
      <img src={data.media.src} alt={data.media.alt} class="h-full min-h-[360px] w-full rounded-[20px] object-cover" />
    ) : (
      <div class="flex min-h-[360px] items-center justify-center rounded-[20px] border border-dashed border-white/15 bg-white/5 text-sm uppercase tracking-[0.24em] text-white/45">
        Hero media
      </div>
    )}
  </div>
</section>
